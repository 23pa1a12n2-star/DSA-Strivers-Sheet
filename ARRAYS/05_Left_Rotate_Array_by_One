class Solution:
    def rotate(self, nums: list[int], k: int) -> None:
        n = len(nums)
        k = k%n
        if k == 0:
            return

        def reverse(left,right):
            while left<right:
                temp = nums[left]
                nums[left] = nums[right]
                nums[right] = temp

                right-=1
                left+=1

        reverse(0,n-1)
        reverse(0,k-1)
        reverse(k,n-1)
